# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/docio

# Logging
LOG_LEVEL=info

# CORS — frontend origin. Leave blank to allow all origins (dev convenience).
# In production, set to the exact origin (or comma-separated list).
# CLIENT_ORIGIN=http://localhost:5173

# JWT — generate with `openssl rand -base64 48`. Must be at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Bcrypt cost factor (10–12 dev, 12+ prod).
BCRYPT_COST=12

# Refresh-token cookie options. 'lax' for cross-port localhost dev.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Application URL — used in email links (reset-password, eventually email verification).
PUBLIC_APP_URL=http://localhost:5173

# Password reset — TTL of the hashed reset token, in minutes. Short by design.
PASSWORD_RESET_EXPIRES_IN_MIN=15

# Mail — when SMTP_HOST is unset, the mailer falls back to a dev logger that prints the
# reset URL into the Pino log so a developer can copy/paste it. Configure SMTP_* to send
# real email in prod. Set SMTP_SECURE=true for port 465 (TLS), false for 587 (STARTTLS).
MAIL_FROM=noreply@docio.test
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@docio.test
# SMTP_PASS=
